@model Docttors_portal.Common.procedureModels.GetDoctorMessageDetails
@{
    ViewBag.Title = "OpenMessage";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}
<h2>OpenMessage</h2>
<article class="box post" id="pagecontainer_main">
    <div id="printablediv">
        <h3 id="ctl00_ContentPlaceHolder1_headerDetails" class="text-center">Message From Patient</h3>
        <div class="row g-3 justify-content-between mt-lg-0 mt-4" id="messagebox">
            <label id="ctl00_ContentPlaceHolder1_message" style="color: red"></label>
            <div class="col-auto col-sm-auto col-md-auto col-lg-auto fs-5" style="padding-left: 40px">
                <p>
                    <b>From :</b>
                    <span>@Model.PatientName</span>
                </p>
                <p>
                    <b>Subject :</b>
                    <span style="font-size:18px">@Model.Subject</span>
                </p>
            </div>
            <div class="col-auto col-sm-auto col-md-auto col-lg-auto fs-5">
                <p>
                    <b>To :</b>
                    <span>@Model.DoctorName</span>
                </p>
                <p>
                    <b>Date :</b>
                    <span>@Model.CreatedOn</span>
                </p>
            </div>
        </div>
        <div class="card">
            <div class="card-header" style="background-color: #1434A4;">
                <h3 class="card-title text-white">Patient Personal Details</h3>
            </div>
            <div class="card-body d-lg-flex justify-content-lg-between" id="divFirst">
                <div class="col-lg-6 fs-5">
                    <div class="col-auto">
                        <p>
                            <b>Name :</b>@Model.PatientName
                        </p>
                        <p id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_ucmcSexlbl">
                            <b>Sex :</b>@Model.Sex
                        </p>

                        <p>
                            <b>Date of Birth :</b>@Model.Dob
                        </p>
                    </div>
                </div>
                <div class="col-lg-6 fs-5">
                    <div class="col-auto">

                        <p id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_ucmcPhonelbl">
                            <b>Phone :</b>@Model.Phone
                        </p>
                        <p id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_ucmcHWGTlbl">
                            <b>Height/Weight :</b>@Model.HeightWeight
                        </p>
                        <p id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_ucmcAddresslbl">
                            <b>Address :</b>@Model.Address
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_insuranceHeadDiv" class="card-header d-flex justify-content-between" style="background-color: #1434A4; cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#pid" aria-expanded="false" aria-controls="pid">
                <h3 class="card-title text-white">Patient Insurance Details</h3>
            </div>
            <div class="collapse" id="pid">
                <div id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_insuranceBodyDiv" class="card-body d-lg-flex justify-content-lg-between">
                    <div class="col-lg-6 fs-5">
                        <div class="col-auto">
                            <p>
                                <b>Insurance Company:&nbsp;</b>@Model.InsuranceCompanyName
                            </p>
                            <p>
                                <b>Insurance Company Address:&nbsp;</b>
                                @Model.InsuranceCompanyAddress
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-6 fs-5">
                        <div class="col-auto">
                            <p>
                                <b>Phone:&nbsp;</b>
                                @Model.InsuranceCompanyphone
                            </p>
                            <p>
                                <b>Insurance Plan Number:&nbsp;</b>@Model.InsuranceIdNumber
                            </p>
                            <p>
                                <b>Insurance Group ID:&nbsp;</b>@Model.InsuranceGroupId
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_pharmacyDiv" class="card-header" style="background-color: #1434A4; cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#ppd" aria-expanded="false" aria-controls="ppd">
                <h3 class="card-title text-white">Patient Pharmacy Details</h3>
            </div>
            <div class="collapse" id="ppd">
                <div id="ctl00_ContentPlaceHolder1_OpenMessage1_MessagePersonalInsurance1_pharmacyDetailsDiv" class="card-body d-lg-flex justify-content-lg-between">
                    <div class="col-lg-6 fs-5">
                        <div class="col-auto">
                            <p>
                                <b>Name :</b>@Model.PharmacyName
                            </p>
                            <p>
                                <b>Address :</b>@Model.PharmacyAddress
                            </p>
                            <p>
                                <b>City :</b>@Model.PharmacyCity
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-6 fs-5">
                        <div class="col-auto">
                            <p>
                                <b>State :</b>@Model.PharmacyState
                            </p>
                            <p>
                                <b>Phone :</b>@Model.PharmacyPhone
                            </p>
                            <p>
                                <b>Zip :</b>@Model.PharmacyZipCode
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>


