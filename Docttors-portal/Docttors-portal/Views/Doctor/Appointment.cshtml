@model Docttors_portal.Common.Models.DoctorAppointmentData
@{
    ViewBag.Title = "Appointment";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<h3 class="text-center">Set my Schedule: (for Video Face to Face Visits only)</h3>
<p class="text-center mt-1">
    Please checkmark the times you are available to provide Face to Face Video Visits
</p>
@using (Html.BeginForm("Appointment", "Doctor", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    <div class="row">
        <div class="mb-2 col-md-3 pe-1">
            <span id="ctl00_ContentPlaceHolder1_Label1" class="form-label">SELECT DATE</span>
            @Html.TextBoxFor(model => model.SelectedDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(model => model.SelectedDate, "", new { @class = "text-danger" })
            <span style="color:Red;visibility:hidden;">Please select Start Date</span>
        </div>
        <div class="mb-2 mt-4 col-md-3">
            <span class="form-label" style="font-weight: 600;"><b>Selected Date : </b><u>@Model.SelectedDate</u></span>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 mt-0">
            <div class="card">
                <div class="card-header border-bottom" style="background-color: #1434A4; color: #fff; font-weight: 700; font-size: 15px;">
                    Midnight-8am
                    <span class="clschkIsPrimaryDoctor" data-id="5" style="right: 70px; position: absolute; color: #fff;">
                        <input id="chkMorning" type="checkbox" name="chkMorning"><label>&nbsp; Check All</label>
                    </span>
                </div>
                <div class="card-body">
                    <table class="row g-3 justify-content-evenly" border="0">
                        <tbody>
                            <tr class="row tr-morning">
                                @for (int i = 0; i < Model.MorningAppointmentData.Count; i++)
                                {
                                    <td class="col-md-3">
                                        <span>
                                            @Html.HiddenFor(m => m.MorningAppointmentData[i].Id)
                                            @Html.CheckBoxFor(m => Model.MorningAppointmentData[i].IsChecked,new{@class="test" })
                                            <label>@Model.MorningAppointmentData[i].ScheduleDisplayName</label>
                                        </span>
                                    </td>
                                }
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-12 mt-0">
            <div class="card">
                <div class="card-header border-bottom" style="background-color: #1434A4; color: #fff; font-weight: 700; font-size: 15px;">
                    8am-4pm
                    <span class="clschkIsPrimaryDoctor" data-id="5" style="right: 70px; position: absolute; color: #fff;">
                        <input id="chkDay" name="chkDay" type="checkbox"><label>&nbsp; Check All</label>
                    </span>
                </div>
                <div class="card-body">
                    <table class="row g-3 justify-content-evenly" border="0">
                        <tbody>
                            <tr class="row tr-day">
                                @for (int i = 0; i < Model.DayAppointmentData.Count; i++)
                                {
                                    <td class="col-md-3">
                                        <span>
                                            @Html.HiddenFor(m => m.DayAppointmentData[i].Id)
                                            @Html.CheckBoxFor(m => Model.DayAppointmentData[i].IsChecked)
                                            <label>@Model.DayAppointmentData[i].ScheduleDisplayName</label>
                                        </span>
                                    </td>
                                }
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-12 mt-0">
            <div class="card">
                <div class="card-header border-bottom" style="background-color: #1434A4; color: #fff; font-weight: 700; font-size: 15px;">
                    4pm-Midnight
                    <span class="clschkIsPrimaryDoctor" data-id="5" style="right: 70px; position: absolute; color: #fff;">
                        <input id="chkEvening" name="chkEvening" type="checkbox"><label>&nbsp; Check All</label>
                    </span>
                </div>
                <div class="card-body">
                    <table id="ctl00_ContentPlaceHolder1_chkScheduler2" class="row g-3 justify-content-evenly" border="0">
                        <tbody>
                            <tr class="row tr-evening">
                                @for (int i = 0; i < Model.EveningAppointmentData.Count; i++)
                                {
                                    <td class="col-md-3">
                                        <span>
                                            @Html.HiddenFor(m => m.EveningAppointmentData[i].Id)
                                            @Html.CheckBoxFor(m => Model.EveningAppointmentData[i].IsChecked)
                                            <label>@Model.EveningAppointmentData[i].ScheduleDisplayName</label>
                                        </span>
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>



        <div class="row mt-0 justify-content-center mb-1">
            <div class="col-auto col-lg-auto">
                <input type="submit" value="Save" class="btn text-white" style="background-color: #1434A4;">
            </div>
        </div>
    </div>
}
@section Scripts
{
    <script type="text/javascript">
        $('#SelectedDate').change(function () {
            var selectedDate = $('#SelectedDate').val();
            location.href = "/Doctor/Appointment?dateString=" + selectedDate;
        })

        $(document).ready(function () {
            var isAllChecked = true;
            $('tr.tr-morning > td').each(function () {
                var isChecked = $(this).find('span input.test').prop('checked');
                if (isChecked) {

                } else {
                    isAllChecked = false;
                }
            })
            if (isAllChecked) {
                $('#chkMorning').attr('checked', true);
            }
            var isAllDayChecked = true;
            $('tr.tr-day > td').each(function () {
                var isChecked = $(this).find('span input.test').prop('checked');
                if (isChecked) {

                } else {
                    isAllDayChecked = false;
                }
            })
            if (isAllDayChecked) {
                $('#chkDay').attr('checked', true);
            }
            var isAllEveningChecked = true;
            $('tr.tr-evening > td').each(function () {
                var isChecked = $(this).find('span input.test').prop('checked');
                if (isChecked) {

                } else {
                    isAllEveningChecked = false;
                }
            })
            if (isAllEveningChecked) {
                $('#chkEvening').attr('checked', true);
            }
        })

        $('#chkMorning').click(function () {
                $('tr.tr-morning > td > span > input').attr('checked', this.checked)
        })
        $('#chkDay').click(function () {
            $('tr.tr-day > td > span > input').attr('checked', this.checked)
        })
        $('#chkEvening').click(function () {
            $('tr.tr-evening > td > span > input').attr('checked', this.checked)
        })
    </script>
}