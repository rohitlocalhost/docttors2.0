@model List<Docttors_portal.Common.procedureModels.GetpatientMessage>
@{
    ViewBag.Title = "Inbox";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}
<article class="box post">
    <h4 style="color: #1434A4;">
        <span><u>INBOX</u> (<strong id="ctl00_ContentPlaceHolder1_span_NumberofMessage">0</strong>)</span>/
        <span><a href="sent.aspx">SENT</a>/</span>
        <span><a href="CCM.aspx">CCM</a> /</span>
        <span id="ctl00_ContentPlaceHolder1_inviteSpan"><a href="invites.aspx">INVITES</a>/ </span>
        <span id="ctl00_ContentPlaceHolder1_spnreferals"><a href="referals.aspx">REFERALS</a></span>
    </h4>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>
                                <a>From</a>
                            </th>
                            <th></th>
                            <th>
                                <a>Type of Service</a>
                            </th>

                            <th>
                                <a>Symptom</a>
                            </th>

                            <th>
                                <a>Date/Time Rec’d</a>
                            </th>

                            <th>
                                <a>Appt Time</a>
                            </th>
                            <th>
                                <a>SSN#</a>
                            </th>
                            <th>
                                <a>Complete</a>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.patientName
                                </td>
                                <td>
                                    @item.ProviderName
                                </td>
                                <td>
                                    <a href="OpenMessage.aspx?ID=K1iUFbusi1MQWsV%2bfPz9Tw%23%23&amp;source=ShNfn5Qxs%2f29Sw3074iD4Q%23%23">@item.ServiceType</a>
                                </td>
                                <td>
                                    <span>@item.Symptoms</span>
                                </td>
                                <td>
                                    <span>@item.DateTimeRequested</span>
                                </td>
                                <td>
                                    <span>@item.AppointmentDate</span>
                                </td>
                                <td>
                                    @item.SSN
                                </td>
                                <td>
                                    @Html.CheckBoxFor(x => item.IsTreated, new { Step1Id = item.Step1Id, @class = "toggle", data_url = Url.Action("CompleteTreatment", "Doctor"), @disabled = !item.IsTreated })
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.Count == 0)
                {
                    <p>There are no messages in your Inbox folder.</p>
                }
                <div class="row" id="Div2">
                    <div class="col-sm-12 col-md-5">
                        <div id="ctl00_ContentPlaceHolder1_PagingControl_pageLocationText" class="dataTables_info" role="status" aria-live="polite">Showing 1-0 of @Model.Count  &nbsp;&nbsp;</div>
                    </div>
                    <div class="col-sm-12 col-md-7">
                        <div class="row dataTables_paginate paging_simple_numbers" id="datatable_paginate">
                            <span class="col-md-4" style="text-align: right"></span>
                            <ul class="col-md-1 pagination">
                                <li id="ctl00_ContentPlaceHolder1_PagingControl_pageNumbersLinks" class="paginate_button page-item active">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</li>
                            </ul>
                            <span class="col-md-1" style="text-align: left"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</article>
@section scripts {
    <script>
        $(function () {
            $('.toggle').change(function () {
                var self = $(this);
                var url = self.data('url');
                var id = self.attr('step1Id');
                var value = self.prop('checked');
                if (value) {
                    $.ajax({
                        url: url,
                        data: { Step1Id: id },
                        type: 'GET',
                        success: function (response) {
                            //alert(response);
                        }
                    });
                }
            });
        });
    </script>
}
