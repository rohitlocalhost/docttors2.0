    <script type="text/javascript">
        $(document).ready(function () {
            /*Adding language script from here */
            $('#btnAddLang').click(function () {
                var newlang = $('#txtNewlang').val();
                if (newlang != '') {
                    $('#errorlang').css({ visibility: 'hidden' });
                    var langText = $('#language').val();
                    if (langText != '') {
                        if ($('#language').val() != '' && langText.indexOf(newlang) < 0) {
                            $('#language').val($('#language').val() + ',' + newlang);
                        }
                    } else {
                        $('#language').val(newlang);
                    }
                } else {
                    $('#errorlang').css({ visibility: 'visible' });
                }
            })
            $('#btnRemoveLang').click(function () {
                var removelang = $('#txtNewlang').val();
                var langText = $('#language').val();
                if (removelang != '') {
                    $('#errorlang').css({ visibility: 'hidden' });
                    const arrayLang = langText.split(',');
                    $('#language').val('');
                    for (a in arrayLang) {
                        if (removelang != arrayLang[a]) {
                            if ($('#language').val() != '') {
                                $('#language').val($('#language').val() + ',' + arrayLang[a]);
                            } else {
                                $('#language').val(arrayLang[a]);
