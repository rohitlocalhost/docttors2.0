@model Docttors_portal.Common.Models.PatientFavouriteDoctor
@{
    ViewBag.Title = "MyProvider";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div>
    <h3>YOU HAVE @Model.getDoctorsByPatients.Count PROVIDER(S) AS YOUR FAVORITE</h3>
    <h6>To add more doctors click <a href="/Patient/Search">Search</a> and add to your favorite list.</h6>
    @foreach (var doctorInfo in Model.getDoctorsByPatients)
    {
        <div class="col-lg-12 mt-4">
            <div class="card">
                <div class="card-header border-bottom d-flex justify-content-between text-white" style="background-color: #1434A4;">
                    <h3 class="card-title">@doctorInfo.Name</h3>
                    <div class="form-check">
                        @Html.CheckBoxFor(m => doctorInfo.IsprimaryDoctor, new { id = doctorInfo.FavoriteDoctorId, @class = "toggle" })
                        <label class="form-check-label" for="flexCheckDefault">
                            Is Primary Doctor
                        </label>
                    </div>
                    <a title="your doctor has been added to your list of favorites" href="@Url.Action("RemoveFavouriteDoctor", "Patient", new { favouriteId = doctorInfo.FavoriteDoctorId })" class="btn btn-danger">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
                <div class="card-body">
                    <div class="row justify-content-evenly">
                        <div class="col-lg-3">
                            <img class="img-fluid" src="../../assets/images/doctoricon.png">
                        </div>
                        <div class="col-lg-7">
                            <p class="mt-sm-2">
                                The Appointment times (which are shown after clicking on Video Chat button) are for Face-to-Face Video Chat with your favorite doctor. <br>
                                You don’t need an appointment for Video e-mail, ask as doctor and prescription refills.
                            </p>
                            <p>
                                <b>Address</b> : @doctorInfo.Address <br>
                                <b>Phone</b> : @doctorInfo.Phone <br>
                                <b>Email</b> : <a href="mailto: atharva18@gmail.com">@doctorInfo.EmailAddress</a>
                            </p>
                            <div id="dvDatePicker" style="display:none;">
                                <label style="color:#1434A4;">Select Appointment Date</label>
                                <input type="date">
                            </div>
                            <p></p>
                            <div class="col-lg-12 d-flex">
                                <button class="btn btn-sm" onclick="window.location='/patient/OnlineVisitConfirmation?pageType=2082&doctorId=@doctorInfo.UserId'" fdprocessedid="80y85s"><img class="img-fluid" src="../../assets/images/Videochat.png"><br>$ @doctorInfo.VideoChat</button>
                                <button class="btn btn-sm" onclick="window.location='/patient/OnlineVisitConfirmation?pageType=2083&doctorId=@doctorInfo.UserId'" fdprocessedid="x2sslk"><img class="img-fluid" src="../../assets/images/videoemail.png"><br>$ @doctorInfo.VideoEmail</button>
                                <button class="btn btn-sm" onclick="window.location='/patient/OnlineVisitConfirmation?pageType=2084&doctorId=@doctorInfo.UserId'" fdprocessedid="rch0wu"><img class="img-fluid" src="../../assets/images/askadoc.png"><br>$ @doctorInfo.AskDoctor</button>
                                <button class="btn btn-sm" onclick="window.location='/patient/OnlineVisitConfirmation?pageType=2085&doctorId=@doctorInfo.UserId'" fdprocessedid="dz10sr"><img class="img-fluid" src="../../assets/images/refill.png"><br>$ @doctorInfo.Refill</button>
                            </div>
                        </div>
                    </div>
                    <!-- </blockquote> -->
                </div>
            </div>
        </div>
    }
</div>
@section Scripts{
    <script type="text/javascript">
        $(function () {
            $('.toggle').change(function () {
                var self = $(this);
                var url = '/Patient/UpdatePrimaryDoctor';
                var id = self.attr('id');
                var value = self.prop('checked');
                $.ajax({
                    url: url,
                    data: { favouriteId: id, isprimary: value },
                    type: 'POST',
                    success: function (response) {
                    }
                });
            });
        });
        function videoChat(){
           // $('#dvDatePicker').show();
        }
    </script>
}