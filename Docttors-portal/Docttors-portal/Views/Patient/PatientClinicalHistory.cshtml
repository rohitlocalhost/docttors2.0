                        </a>
                    </div>

                    <div class="col-md-2">
                        <input type="submit" value="Save" class="btn btn-rounded btn-success btn-wave" />
                    </div>
                </div>

            }

        </div>

    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        $('.clsChronicConditions').click(function () {
            if (this.checked) {
                $(this).parent().find('input.txtChronicConditions').attr('disabled', false)
            } else {
                $(this).parent().find('input.txtChronicConditions').attr('disabled', true)
                $(this).parent().find('input.txtChronicConditions').val('')
            }
        })
    </script>
}