                                    <span>@Model.allChronicConditions[i].Name</span>
                                    <div class="input-group">
                                        <span class="input-group-addon mt-2 pe-1">
                                            @Html.CheckBoxFor(m => Model.allChronicConditions[i].IsChecked, new { @class = "clsChronicConditions" })
                                            @Html.TextBoxFor(m => m.allChronicConditions[i].Text, new { @class = "txtChronicConditions", @disabled = true })
