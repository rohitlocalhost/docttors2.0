@model Docttors_portal.Common.Models.PatientClinicalViewModel
@{
    ViewBag.Title = "PatientClinicalHistory";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="card">
    <div class="card-header text-white" style="background-color: #1434A4;">
        <h2 class="card-title">
            Clinical History
            <span style="font-size: 12px;"><a style="color: red;" id="help" onclick="helpclick(this)" href="#">Help?</a></span>
        </h2>
    </div>
    <div class="card-body">
        <div id="ctl00_ContentPlaceHolder1_UpdatePanel1">
            <span id="ctl00_ContentPlaceHolder1_lblMessage"></span>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Active Problem List</h3>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("patientCondition", "Patient", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(model => model.PatientConditionInfo.patientConditionViewModel.Id)
                        <div class="row justify-content-lg-start justify-content-center">
                            <div class="col-md-2">
                                <label>Condition/Illness <span style="color: red">*</span></label>
                            </div>
                            <div class="col-md-2">
                                @Html.TextBoxFor(x => x.PatientConditionInfo.patientConditionViewModel.Condition)
                                @Html.ValidationMessageFor(model => model.PatientConditionInfo.patientConditionViewModel.Condition, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-4 ms-lg-3">
                                <input type="submit" value="Save" class="btn text-white" style="background-color: #1434A4;" />
                            </div>
                        </div>
                    }
                    <div class="row mt-3 g-2 justify-content-around">
                        @foreach (var item in Model.PatientConditionInfo.patientConditionData)
                        {
                            <div class="col-auto col-sm-auto col-md-4 col-lg-auto">
                                <div class="card-body rounded-3" style="background-color: #ffdbac;">
                                    <b>Condition: </b>@item.Condition
                                    <a href="@Url.Action("DeletePatientCondition", "Patient", new {@patientConditionId=item.Id})"><i class="fas fa-trash-alt"></i></a>
                                </div>
                            </div>
                        }

                    </div>

                </div>
            </div>

