@section Scripts
{
    <script type="text/javascript">
        debugger
        var urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('step')) {
            $('#tabList li:first a').removeClass('active');
            $('.tab-content div').removeClass('active');
            const stepValue = parseInt(urlParams.get('step'));
            switch (stepValue) {
                case 2:
                    $('#step-1').hide();
                    $('#step-3').hide();
                    $('#tabList li:nth-child(2) a').addClass('active');
                    $('#step-' + stepValue).addClass('active');
                    break;
                case 3:
                    $('#step-1').hide();
                    $('#step-2').hide();
                    $('#tabList li:nth-child(3) a').addClass('active');
                    $('#step-' + stepValue).addClass('active');
                    break;
                case 4:
                    break;
                case 5:
                    $('#step-1').hide();
                    $('#step-2').hide();
                    $('#step-3').hide();
                    $('#step-4').hide();
                    $('#tabList li:nth-child(5) a').addClass('active');
                    $('#step-' + stepValue).addClass('active');
                    break;
                case 6:
                    $('#step-1').hide();
                    $('#step-2').hide();
                    $('#step-3').hide();
                    $('#step-4').hide();
                    $('#step-5').hide();
                    $('#tabList li:nth-child(6) a').addClass('active');
                    $('#step-' + stepValue).addClass('active');
                    break;

            }
        }
        $('#btnSkip').click(function () {
             var url = '@Url.Action("OnlineVisitStep", "Patient", new { step =5,VisitId=0 })';
            window.location.href = '/Patient/OnlineVisitStep?step=5&VisitId=0';
        })
    </script>
}