@model Docttors_portal.Common.Models.MyProvider
@{
    ViewBag.Title = "OnlineVisitInfo";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<h2>OnlineVisitInfo</h2>
<style>
    .mr-6 {
        margin: 0 0 0 16px;
    }
</style>
<div class="card">
    <div class="card-body">
        <!-- Nav tabs -->
        <ul id="tabList" class="nav nav-pills nav-justified border" role="tablist">
            <li class="nav-item waves-effect waves-light" role="presentation">
                <a class="nav-link active" data-bs-toggle="tab" href="#step-1" role="tab" aria-selected="true" tabindex="-1">
                    Personal
                </a>
            </li>
            <li class="nav-item waves-effect waves-light" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#step-2" role="tab" aria-selected="false" tabindex="-1">
                    Complaint
                </a>
            </li>
            <li class="nav-item waves-effect waves-light" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#step-3" role="tab" aria-selected="false" tabindex="-1">
                    Condition
                </a>
            </li>
            <li class="nav-item waves-effect waves-light" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#step-4" role="tab" aria-selected="false" tabindex="-1">
                    Symptoms
                </a>
            </li>
            <li class="nav-item waves-effect waves-light" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#step-5" role="tab" aria-selected="false" tabindex="-1">
                    Video
                </a>
            </li>
            <li class="nav-item waves-effect waves-light" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#step-6" role="tab" aria-selected="false" tabindex="-1">
                    Payment
                </a>
            </li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content p-3 text-muted mt-5">
            <div class="tab-pane active show" id="step-1" role="tabpanel">
                <div class="card-body">
                    @using (Html.BeginForm("OnlineVisitInfo", "Patient", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)
                        <div class="card">
                            <div class="card-header border-primary d-flex justify-content-between">
                                <h3 class="card-title" style="color: #1434A4;">Personal Details</h3>
                                <a href="/Patient/PersonalDetails">Update</a>
                            </div>
                            <div class="card-body d-lg-flex">
                                <div class="col-lg-6">
                                    <p><b>Name: </b><span id="ctl00_ContentPlaceHolder1_spnName">@Model.PersonalTab.PatientPersonalModel.FirstName  @Model.PersonalTab.PatientPersonalModel.LastName</span></p>
                                    <p><b>Date of Birth: </b><span id="ctl00_ContentPlaceHolder1_spnDob">@Model.PersonalTab.PatientPersonalModel.DOB</span></p>
                                    <p><b>Gender: </b><span id="ctl00_ContentPlaceHolder1_spnGender">@Model.PersonalTab.PatientPersonalModel.GenderList.FirstOrDefault(x => x.Id == Model.PersonalTab.PatientPersonalModel.GenderId).Name</span></p>
                                    <p><b>Height: </b><span id="ctl00_ContentPlaceHolder1_spnHeight">@Model.PersonalTab.PatientPersonalModel.HeightList.FirstOrDefault(x => x.Id == Model.PersonalTab.PatientPersonalModel.HeightId).Name</span></p>

                                </div>
                                <div class="col-lg-6">
                                    <p><b>Address: </b><span id="ctl00_ContentPlaceHolder1_spnAddress">@Model.PersonalTab.PatientPersonalModel.City, @Model.PersonalTab.PatientPersonalModel.Address (@Model.PersonalTab.PatientPersonalModel.ZipCode)</span></p>
                                    <p><b>E-mail: </b><span id="ctl00_ContentPlaceHolder1_spnEmail">@Model.PersonalTab.PatientPersonalModel.EmailId</span></p>
                                    <p><b>Cellphone: </b><span id="ctl00_ContentPlaceHolder1_spnCellPhone">@Model.PersonalTab.PatientPersonalModel.ContactNo</span></p>
                                    <p><b>Weight: </b><span id="ctl00_ContentPlaceHolder1_spnWeight">@Model.PersonalTab.PatientPersonalModel.Weight</span></p>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header border-primary d-flex justify-content-between">
                                <h3 class="card-title" style="color: #1434A4;">Insurance Details</h3>
                                <a href="/Patient/Insurance">Update</a>
                            </div>
                            <div class="card-body d-lg-flex">
                                <div class="col-lg-6">
                                    <p><b>Name Of Insured: </b><span>@Model.PersonalTab.PatientInsuranceModel.NameOfInsured</span></p>
                                    <p><b>Insurance Plan Number: </b><span>@Model.PersonalTab.PatientInsuranceModel.InsuranceIdNumber</span></p>
                                    <p><b>Insurance Company: </b><span>@Model.PersonalTab.PatientInsuranceModel.InsuranceCompanyName</span></p>
                                </div>
                                <div class="col-lg-6">
                                    <p><b>Relation Of Patient: </b><span>@Model.PersonalTab.PatientInsuranceModel.RelationshipToPatient</span></p>
                                    <p><b>Insurance Group ID: </b><span>@Model.PersonalTab.PatientInsuranceModel.InsuranceGroupId</span></p>
                                    <p><b>Insurance Phone Number: </b><span>@Model.PersonalTab.PatientInsuranceModel.InsuranceCompanyPhone</span></p>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header border-primary d-flex justify-content-between">
                                <h3 class="card-title" style="color: #1434A4;">Medication History</h3>
                                <a href="/Patient/MedicationDetails">Update</a>
                            </div>
                            <div class="card-body d-lg-flex">
                                <div class="row col-md-12">
                                    @foreach (var item in Model.PersonalTab.patientMedicationList)
                                    {
                                        <div class="col-lg-4">
                                            <div class="card">
                                                <div class="card-header">
                                                    <span style="float: right"></span><strong>Medication Name:&nbsp;&nbsp;</strong>@item.MedicationName
                                                </div>
                                                <div class="card-body">
                                                    <p>
                                                        <strong>Dosage in MG:&nbsp;&nbsp;</strong>@item.Dosage<br>
                                                        <strong>Frequency:&nbsp;&nbsp;</strong>@item.Frequency<br>
                                                        <strong>Prescription:&nbsp;&nbsp;</strong>@item.Prescription<br>
                                                        <strong>Date:&nbsp;&nbsp;</strong>@item.DateOfPrescription<br>
                                                        <strong>Physician Prescribed:&nbsp;&nbsp;@item.PrescibedPhysician</strong><br>
                                                        <strong>Current Medication:&nbsp;&nbsp;</strong>@(item.CurrentMedication ? "yes" : "No") <br>
                                                        <strong>Reason for Prescription:&nbsp;&nbsp;</strong>@item.ReasonforPrescription

                                                    </p><div class="clearfix">
                                                    </div>
                                                    <p></p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header border-primary d-flex justify-content-between">
                                <h3 class="card-title" style="color: #1434A4;">Clinical History</h3>
                                <a href="/Patient/PatientClinicalHistory">Update</a>
                            </div>
                            <div class="card-body d-lg-flex" id="clinicalHistory">
                                <div class="row col-md-12">
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Diagnosis</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.allChronicConditions)
                                                {
                                                    if (item.IsChecked)
                                                    {
                                                        @item.Name <span class="greytext">: <font color="red"> Yes </font><br></span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Social History</h5></div>
                                            <div class="card-body">
                                                Cancer <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsCancer > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsCancer).Name : "") </font><br></span>
                                                Diabetes <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsDiabetes > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsDiabetes).Name : "") </font><br></span>
                                                High BP <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsBloodPressure > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsBloodPressure).Name : "")</font><br></span>
                                                Heart Disease <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsHeartDisease > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsHeartDisease).Name : "")</font><br></span>
                                                Alcohol Abuse <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsAlcoholAbuse > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsAlcoholAbuse).Name : "")</font><br></span>
                                                Drug Abuse <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsDrugAbuse > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientClinicalHistoryModel.IsDrugAbuse).Name : "")</font><br></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Family History</h5></div>
                                            <div class="card-body">
                                                Smoke <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientSocialHisotryModel.IsSmoke > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSocialHisotryModel.IsSmoke).Name : "") </font><br></span>
                                                Drug <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientSocialHisotryModel.IsDrugs > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSocialHisotryModel.IsDrugs).Name : "") </font><br></span>
                                                Alcohal <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientSocialHisotryModel.IsAlcohol > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoSelectionList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSocialHisotryModel.IsAlcohol).Name : "")</font><br></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Surgucal History</h5></div>
                                            <div class="card-body">
                                                Tonsils <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsTonsils > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoDontKnowList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsTonsils).Name : "") </font><br></span>
                                                Appendix <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsAppendix > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoDontKnowList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsAppendix).Name : "") </font><br></span>
                                                Gallbladder <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsGallbladder > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoDontKnowList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsGallbladder).Name : "")</font><br></span>
                                                Stent <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsStent > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoDontKnowList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsStent).Name : "")</font><br></span>
                                                Heart ByPass <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsHeartByPass > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoDontKnowList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsHeartByPass).Name : "")</font><br></span>
                                                Hysterectomy <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsHysterectomy > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoDontKnowList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsHysterectomy).Name : "")</font><br></span>
                                                Cataracts <span class="greytext">: <font color="red"> @(Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsCataracts > 0 ? @Model.PersonalTab.patientClinicalViewModel.YesNoDontKnowList.FirstOrDefault(x => x.Id == Model.PersonalTab.patientClinicalViewModel.patientSurgicalHistoryModel.IsCataracts).Name : "")</font><br></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>General</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.GeneralConditionList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.GeneralCondition == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Endocrine</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.EndocrineorDiabetesList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Diabetes == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Gastrointestinal</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.StomachList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Stomach == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Genitourinary</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.UrinaryList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Urinary == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Neurological</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.NeurologicalList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Neurological == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Cardiovascular</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.CardiovascularList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Cardiovascular == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Respiratory</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.RespiratoryList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Respiratory == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Eyes</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.EyesList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Eyes == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Ear</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.EarList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Ear == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>OB/Gyn</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.ObOrGynList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.ObOrGyn == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Musculoskeletal</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.MusclesOrJointsList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.MusclesOrJoints == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Skin</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.SkinList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Skin == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Hematology/Lymphatic</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.CancerOrHematologyList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Hematology == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Dental</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.DentalList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Dental == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="card">
                                            <div class="card-header"><h5>Psychologic</h5></div>
                                            <div class="card-body">
                                                @foreach (var item in Model.PersonalTab.patientClinicalViewModel.PsychologicalList)
                                                {
                                                    @item.Name <span class="greytext">: <font color="red">@(Model.PersonalTab.patientClinicalViewModel.patientReviewOfSystemModel.Psychological == item.Id ? "Yes" : "No") </font><br></span>
                                                }
                                            </div>
                                        </div>
                                    </div>



                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header border-primary d-flex justify-content-between">
                                <h3 class="card-title" style="color: #1434A4;">Allergy Information</h3>
                                <a href="/Patient/PatientAllergies">Update</a>
                            </div>
                            <div class="card-body d-lg-flex">
                                <div class="row col-md-12">
                                    @foreach (var item in Model.PersonalTab.AllergyList)
                                    {
                                        <div class="col-lg-3">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h2 class="card-title">
                                                        <strong>Allergy Name: &nbsp;</strong>@item.AllergyName
                                                    </h2>
                                                </div>
                                                <div class="card-body">
                                                    <p>
                                                        <strong>Allergy Reaction:</strong> &nbsp;@item.Reaction
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            @Html.CheckBoxFor(m => m.PersonalTab.TermAndCondition)
                            <span id="ctl00_ContentPlaceHolder1_stateSpan">  I will update my Personal Health Record before seeking online visit.</span><br />
                            @Html.ValidationMessageFor(x => x.PersonalTab.TermAndCondition, "", new { @class = "text-danger mr-6" })
                        </div>
                        <div class="row">
                            <div class="col-lg-9"></div>
                            <div class="col-lg-auto">
                                <input type="submit" value="Save &amp; Next" class="btn btn-success">
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="tab-pane" id="step-2" role="tabpanel">
                <div class="card-body">
                    @using (Html.BeginForm("OnlineVisitStep2", "Patient", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(x => x.ComplaintTab.Step1Id);
                        @Html.HiddenFor(x => x.ComplaintTab.DoctorId);
                        <div class="col-lg-auto mb-4">
                            <label class="form-label">
                                1
                            </label>
                            What is your Chief Complaint or the Reason for Online Visit?&nbsp;
                            <div class="fom-control">
                                @Html.TextAreaFor(x => x.ComplaintTab.A1, new { @class = "form-control" })
                                @Html.ValidationMessageFor(x => x.ComplaintTab.A1, "", new { @class = "text-danger" })
                            </div>

                        </div>

                        <div class="col-lg-auto mb-4">
                            <label class="form-label">
                                2
                            </label>
                            How many days have you been feeling this way?
                            <div id="ctl00_ContentPlaceHolder1_rprtQuestions_ctl01_pnlTxt" class="fom-control">
                                @Html.TextAreaFor(x => x.ComplaintTab.A2, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-lg-auto mb-4">
                            <label class="form-label">
                                3
                            </label>
                            Do you consider this to be mild, moderate or severe?
                            <div class="fom-control">
                                <table cellspacing="5" border="0">
                                    <tbody>
                                        <tr>
                                            @foreach (var item in Model.ComplaintTab.ComplainTypeList)
                                            {
                                                <td>
                                                    @Html.RadioButtonFor(model => model.ComplaintTab.A3, item.Id)
                                                    @Html.Label(item.Name)
                                                </td>
