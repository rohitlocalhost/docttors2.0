@model Docttors_portal.Common.Models.ConsentForm
@{
    ViewBag.Title = "OnlineVisitConfirmation";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="card">
    <div class="card-header border-bottom" style="background-color: #1434A4;">
        <h4 class="card-title text-white">
            <span id="ctl00_ContentPlaceHolder1_lblVisitType"> @ViewBag.pageType </span>
        </h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("OnlineVisitConfirmation", "Patient", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            <div class="card-blockquote mb-0">
                <div class="row mt-3">
                    <div class="col-lg-12">
                        <p id="ctl00_ContentPlaceHolder1_consentheader">
                            For Secondary authentication, please enter the last four digits of your <b>Social Security Number</b>
                            @Html.TextBoxFor(x => x.SSNNumber, new { maxlength = "4" })
                            @Html.ValidationMessageFor(x => x.SSNNumber, "", new { @class = "text-danger" })
                            <h6 id="ctl00_ContentPlaceHolder1_confirmHeaderText" style="color: red; text-align: right;">For Emergency Call 911</h6>
                        </p>
                    </div>

                </div>

                <div class="panel-body">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div id="cnstdiv" width="500" height="325">
                                <div>
                                    <p style="text-align:justify;" id="mainp">
                                        Online visit portal is for patients complaining of non-urgent matters only. You
                                        represent and warrant that you are at least 18 years of age and possess the legal
                                        right and ability on behalf of yourself or a minor child/parent of whom you are
                                        a parent or legal guardian. You represent and warrant that you have the ability
                                        to consent and to use this Online Patient Care platform and any information you
                                        provide will be truthful, honest and complete. By checking the box <b><u>I Agree</u></b>
                                        you are consenting to truthfully completing questions to the best of your knowledge
                                        and ability. If you do not know the answer or how to answer a question (or if you
                                        do not understand what is being asked) stop using the service.<br>
                                    </p>

                                    <ol type="1">
                                        <li type="1" id="andli">
                                            I understand that the Doctor/Clinic will respond to my <b><u>Ask a Doctor/Nurse or Secure Message</u></b>
                                            question within 4-6 hours
                                        </li>
                                        <li type="1" id="prli">
                                            I understand that the Doctor/Clinic will respond to my <b><u>Prescription Refill </u></b>
                                            request within 4-6 hours
                                        </li>
                                        <li type="1" id="veli">
                                            I understand that the Doctor/Clinic will respond to my <b><u>Video Email Visit</u></b>
                                            request within 4-6 hours
                                        </li>
                                        <li type="1" id="f2fli">
                                            I understand that the Doctor/Clinic will respond to my <b>
                                                <u>
                                                    Video Face-to-Face
                                                    or Video Chat
                                                </u>
                                            </b> request at the time required. I also understand
                                            that I will have to login and go to the Virtual Exam Room 5-10 minutes before the
                                            appointment times. If I fail to show up at the appropriate time, I will forfeit
                                            my consultation fee.
                                        </li>
                                        <li type="1" id="olli">
                                            I understand that if the Online Visit require I go see the doctor in person,
                                            I will be issued a refund which will be reflected in my next credit card statement.
                                        </li>
                                    </ol>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">

                        <div class="form-group">
                            <div class="col-md-12" style="padding: 0px;">
                                <span style="background-color:White;">
                                    @Html.CheckBoxFor(m => m.TermAndCondition)
                                </span>
                                <span id="ctl00_ContentPlaceHolder1_spnAgree">&nbsp; I have read the paragraph above and I understand and agree with all statements made. </span>
                                @Html.ValidationMessageFor(x => x.TermAndCondition, "", new { @class = "text-danger" })
                            </div>

                        </div>
                    </div>

                    <div id="ctl00_ContentPlaceHolder1_stateDiv" class="col-md-12">
                        <div class="form-group">
                            <div class="col-md-12" style="padding: 0px;">
                                @Html.CheckBoxFor(m => m.IsLocatedAlaska)
                                <span id="ctl00_ContentPlaceHolder1_stateSpan">  I certify that I am currently and physically located in Alaska.</span>
                                @Html.ValidationMessageFor(x => x.IsLocatedAlaska, "", new { @class = "text-danger" })
                            </div>

                        </div>
                    </div>



                    <div class="col-md-12">
                        <table id="rdRelation" class="RadioList" border="0">
                            <tbody>
                                <tr>
                                    <td>
                                        @Html.RadioButtonFor(x => x.PatientOrGuardian, true, new { id = "patient" })
                                        @*<input id="ctl00_ContentPlaceHolder1_rdRelation_0" type="radio" name="ctl00$ContentPlaceHolder1$rdRelation" value="1" checked="checked">*@
                                        <label for="patient">I am the patient</label>
                                    </td>
                                    <td>
                                        @Html.RadioButtonFor(x => x.PatientOrGuardian, false, new { id = "guardian" })
                                        @*<input id="ctl00_ContentPlaceHolder1_rdRelation_1" type="radio" name="ctl00$ContentPlaceHolder1$rdRelation" value="2">*@
                                        <label for="guardian">I am the parent/guardian</label>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        @Html.ValidationMessageFor(x => x.PatientOrGuardian, "", new { @class = "text-danger" })
                    </div>


                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <a href="/Patient/MyProvider" class="btn btn-warning float-end">Cancel</a>
                </div>
                <div class="col-5" style="margin:0px 0px 0px 29px">
                    <input type="submit" value="Continue" class="btn btn-success btn-block">
                </div>
            </div>
        }
    </div>
</div>
@section Scripts
{
    <script>
        // extend jquery range validator to work for required checkboxes
        var defaultRangeValidator = $.validator.methods.range;
        $.validator.methods.range = function (value, element, param) {
            if (element.type === 'checkbox') {
                // if it's a checkbox return true if it is checked
                return element.checked;
            } else {
                // otherwise run the default validation function
                return defaultRangeValidator.call(this, value, element, param);
            }
        }
    </script>
}
